{% extends "layout.njk" %}

{% block main %}

{{ imports }}

{% if eventFramingBytes and eventFramingName %}
/// Shared event-framing tag prepended to every framed event emitted by the
/// `{{ program.name | snakeCase }}` program.
pub const {{ eventFramingName }}: [u8; {{ eventFramingBytes.len }}] = {{ eventFramingBytes.literal }};

{% endif %}
/// Event kinds for the `{{ program.name | snakeCase }}` program.
#[derive(Clone, Debug, Eq, PartialEq)]
pub enum {{ program.name | pascalCase }}EventKind {
{% for event in eventsWithDiscriminators | sort(false, false, 'name') %}
    {{ event.name | pascalCase }},
{% endfor %}
}

/// Identifies a `{{ program.name | snakeCase }}` event from the provided data.
{% if framingCheck %}
/// Data that lacks the shared CPI framing is rejected with a single compare.
{% endif %}
pub fn identify_{{ program.name | snakeCase }}_event(data: &[u8]) -> Option<{{ program.name | pascalCase }}EventKind> {
{% if framingCheck %}
    if {{ framingCheck }} {
{% for event in framedEvents | sort(false, false, 'name') %}
        if {{ event.condition }} {
            return Some({{ program.name | pascalCase }}EventKind::{{ event.name | pascalCase }});
        }
{% endfor %}
    }
{% endif %}
{% for event in unframedEvents | sort(false, false, 'name') %}
    if {{ event.condition }} {
        return Some({{ program.name | pascalCase }}EventKind::{{ event.name | pascalCase }});
    }
{% endfor %}
    None
}

/// Parsed event variants for the `{{ program.name | snakeCase }}` program.
#[derive(Clone, Debug{% if eventEnumEq %}, Eq{% endif %}, PartialEq)]
pub enum {{ program.name | pascalCase }}Event {
{% for event in eventsWithDiscriminators | sort(false, false, 'name') %}
    {{ event.name | pascalCase }}({{ event.name | pascalCase }}),
{% endfor %}
}

/// Tries to parse a `{{ program.name | snakeCase }}` event from the provided data.
///
/// Returns `None` when no event matches; `Some(Err(_))` when one matches but fails to
/// deserialize. Use [`Option::transpose`] to propagate failures with `?`, or scan a batch:
///
/// ```ignore
/// let events: Vec<{{ program.name | pascalCase }}Event> = datas
///     .iter()
///     .filter_map(|data| try_parse_{{ program.name | snakeCase }}_event(data))
///     .collect::<Result<_, _>>()?;
/// ```
pub fn try_parse_{{ program.name | snakeCase }}_event(data: &[u8]) -> Option<Result<{{ program.name | pascalCase }}Event, std::io::Error>> {
    let event_kind = identify_{{ program.name | snakeCase }}_event(data)?;
    Some(match event_kind {
{% for event in eventsWithDiscriminators | sort(false, false, 'name') %}
        {{ program.name | pascalCase }}EventKind::{{ event.name | pascalCase }} => {
{% if event.hiddenPrefixSkip.comment %}
            // {{ event.hiddenPrefixSkip.comment }}
{% endif %}
            let mut data = {{ event.hiddenPrefixSkip.expr }};
            {{ event.name | pascalCase }}::deserialize(&mut data)
                .map({{ program.name | pascalCase }}Event::{{ event.name | pascalCase }})
        }
{% endfor %}
    })
}

{% endblock %}
